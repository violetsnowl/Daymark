{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "拾序",
  "version": "0.2.4",
  "identifier": "com.daymark.desktop",
  "build": {
    "frontendDist": "../apps/web/dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "pnpm --filter @daymark/web dev",
    "beforeBuildCommand": "pnpm --filter @daymark/web build"
  },
  "app": {
    "windows": [
      {
        "title": "拾序 Daymark",
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://api.daymark.top https://xaqmzjhvewkrpnqaunwd.supabase.co wss://xaqmzjhvewkrpnqaunwd.supabase.co"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "拾序 Daymark 课程与事项",
    "publisher": "Daymark",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIxODcyNjRFQTJGN0VENEQKUldSTjdmZWlUaWFIc1dZTS8xQlF3c1FaU2swNUlzQVFaRm1sYk9nTjQ2elk4TWxzRFdLaUxwaEcK",
      "endpoints": ["https://api.daymark.top/update/latest.json"]
    }
  }
}
